---
import { site } from '../../data';
const year = new Date().getFullYear();
---

<footer>
  <div class="shell footer-grid">
    <div>
      <p class="footer-mark">Yuxuan 的个人网站</p>
      <p class="footer-description">独立站运营相关的工作经历与项目实践。</p>
    </div>
    <div class="footer-meta">
      <div>
        <span>联系</span>
        <a href={`mailto:${site.email}`}>{site.email}</a>
      </div>
    </div>
  </div>
  <div class="shell copyright">
    <span>© {year} {site.name}</span>
    <span>感谢浏览</span>
  </div>
</footer>

<style>
  footer { padding: 3rem 0 6rem; border-top: 1px solid var(--line); }
  .footer-grid { display: grid; grid-template-columns: 1.4fr .6fr; gap: 3rem; align-items: end; }
  .footer-mark { margin: 0; font-size: 1.4rem; font-weight: 650; }
  .footer-description { margin: .4rem 0 0; color: var(--muted); font-size: .9rem; }
  .footer-meta { min-width: 0; }
  .footer-meta div { display: flex; flex-direction: column; gap: .45rem; }
  .footer-meta span { color: var(--muted); font-size: .68rem; letter-spacing: .12em; text-transform: uppercase; }
  .footer-meta a { font-size: .86rem; overflow-wrap: anywhere; }
  .copyright { display: flex; justify-content: space-between; margin-top: 5rem; padding-top: 1.25rem; border-top: 1px solid var(--line); color: var(--muted); font-size: .7rem; letter-spacing: .03em; }
  @media (max-width: 720px) { .footer-grid { grid-template-columns: 1fr; } .footer-meta { margin-top: 1rem; } .copyright { flex-direction: column; gap: .4rem; } }
</style>
