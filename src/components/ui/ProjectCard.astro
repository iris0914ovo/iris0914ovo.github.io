---
import type { CollectionEntry } from 'astro:content';
type Props = { project: CollectionEntry<'projects'>; large?: boolean; };
const { project, large = false } = Astro.props;
---
<article class:list={['project-card', large && 'project-card--large']} data-category={project.data.category}>
  <a class="cover" href={`/projects/${project.id}/`} aria-label={`查看项目：${project.data.title}`}>
    <img src={project.data.cover} alt={`${project.data.title} 项目封面占位图`} loading="lazy" />
    <span class="view">查看项目 ↗</span>
  </a>
  <div class="card-meta"><span>{project.data.category}</span><span>{project.data.year}</span></div>
  <h3><a href={`/projects/${project.id}/`}>{project.data.title}</a></h3>
  <p>{project.data.summary}</p>
  <div class="tags">{project.data.services.slice(0, 3).map((item) => <span class="tag">{item}</span>)}</div>
</article>
<style>
  .project-card { min-width: 0; }
  .cover { position: relative; display: block; aspect-ratio: 4 / 3; overflow: hidden; background: var(--paper-deep); }
  .project-card--large .cover { aspect-ratio: 16 / 10; }
  img { width: 100%; height: 100%; object-fit: cover; }
  .view { position: absolute; right: 1rem; bottom: 1rem; padding: .6rem .85rem; border-radius: .4rem; background: var(--paper); color: var(--sage); font-size: .7rem; }
  .card-meta { display: flex; justify-content: space-between; margin-top: 1.1rem; color: var(--sage-dark); font-size: .67rem; letter-spacing: .08em; text-transform: uppercase; }
  h3 { margin: .55rem 0 .45rem; font-size: clamp(1.2rem, 2.5vw, 1.5rem); font-weight: 650; line-height: 1.3; }
  h3 a:hover { color: var(--sage-dark); }
  p { max-width: 600px; margin: 0; color: var(--muted); font-size: .86rem; }
  .tags { display: flex; flex-wrap: wrap; gap: .4rem; margin-top: 1rem; }
</style>
