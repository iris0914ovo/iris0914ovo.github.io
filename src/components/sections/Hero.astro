---
import ArrowIcon from '../ui/ArrowIcon.astro';
import { site } from '../../data';
---

<section class="hero shell">
  <div class="hero-top reveal">
    <p class="availability"><span></span>{site.availability}</p>
  </div>
  <h1 class="display reveal reveal-delay">
    你好，我是<em>雨轩。</em>
  </h1>
  <div class="hero-bottom reveal reveal-delay">
    <div>
      <p class="hero-role">独立站运营 / Shopify / SEO / AI 自动化</p>
      <p>目前主要从事跨境电商独立站运营，接触过 Shopify 网站搭建、产品上架、SEO 内容优化、Google / Meta 广告投放等工作，也会使用 n8n 和 AI 工具制作一些自动化流程。这个网站主要用来整理我的工作经历和项目实践。</p>
    </div>
    <div class="hero-actions">
      <a class="button" href="/projects/">查看项目经历 <ArrowIcon /></a>
      <a class="button button--ghost" href="/about/">了解我的经历</a>
    </div>
  </div>
</section>

<style>
  .hero { padding-top: clamp(3rem, 7vw, 6rem); padding-bottom: clamp(3.5rem, 7vw, 6rem); }
  .hero-top { margin-bottom: clamp(2.5rem, 6vw, 5rem); }
  .availability { display: flex; align-items: center; gap: .65rem; margin: 0; color: var(--muted); font-size: .75rem; }
  .availability span { width: .5rem; height: .5rem; border-radius: 50%; background: var(--sage); }
  .hero-bottom { display: grid; grid-template-columns: 1.25fr .75fr; gap: 2rem; align-items: end; margin-top: 1.5rem; }
  .hero-bottom p { max-width: 700px; margin: 0; color: var(--muted); font-size: 1rem; }
  .hero-bottom .hero-role { margin-bottom: 1rem; color: var(--ink); font-size: 1.1rem; font-weight: 600; }
  .hero-actions { display: flex; justify-content: flex-end; gap: .75rem; }
  @media (max-width: 720px) {
    .hero { padding-top: 2.5rem; }
    .hero-top { margin-bottom: 2.5rem; }
    .hero-bottom { grid-template-columns: 1fr; margin-top: 1.5rem; }
    .hero-actions { justify-content: flex-start; flex-wrap: wrap; }
  }
</style>
