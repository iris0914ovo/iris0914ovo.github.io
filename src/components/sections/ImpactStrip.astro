---
import { experience } from '../../data';
---
<section class="impact section-rule" aria-label="工作经历概览">
  <div class="shell impact-grid">
    <div><p class="eyebrow">工作经历</p><h2>我的工作经历</h2><p class="note">任职信息待补充，以下内容不会代替正式简历。</p></div>
    <div class="experience-list">
      {experience.map((item) => <article><span>{item.period}</span><div><h3>{item.role}</h3><p>{item.company}</p><p>{item.description}</p></div></article>)}
      <a class="text-link" href="/about/">查看关于我 <span>→</span></a>
    </div>
  </div>
</section>
<style>
  .impact { padding-block: clamp(3.5rem, 7vw, 6rem); background: var(--paper-deep); }
  .impact-grid { display: grid; grid-template-columns: .55fr 1.45fr; gap: 2rem; }
  h2 { margin: 0; font-size: clamp(1.8rem, 3.5vw, 2.8rem); line-height: 1.2; }
  .note, article p { color: var(--muted); font-size: .9rem; }
  .experience-list { border-top: 1px solid var(--line); }
  article { display: grid; grid-template-columns: .5fr 1fr; gap: 1rem; padding: 1.25rem 0; border-bottom: 1px solid var(--line); }
  article span { color: var(--muted); font-size: .85rem; }
  article h3 { margin: 0; font-size: 1.1rem; font-weight: 600; }
  article p { margin: .2rem 0; }
  .text-link { margin-top: 1.5rem; }
  @media (max-width: 650px) { .impact-grid, article { grid-template-columns: 1fr; } }
</style>
