---
import { getCollection } from 'astro:content';
import SectionHeading from '../ui/SectionHeading.astro';
import ProjectCard from '../ui/ProjectCard.astro';
const projects = (await getCollection('projects')).filter((item) => item.data.featured).sort((a, b) => a.data.order - b.data.order);
---
<section class="section section-rule">
  <div class="shell">
    <SectionHeading eyebrow="Selected work" title="少一些展示，多一些解决问题的过程。" description="以下为保护隐私的示例案例结构。项目信息、图片与成果数据均可在 Markdown 中替换。" />
    <div class="projects-grid">{projects.map((project, index) => <ProjectCard project={project} large={index === 0} />)}</div>
    <div class="more"><a class="text-link" href="/projects/">浏览全部项目 <span>→</span></a></div>
  </div>
</section>
<style>
  .projects-grid { display: grid; grid-template-columns: 1.15fr .85fr; gap: clamp(2rem, 6vw, 6rem); align-items: start; }
  .projects-grid :global(.project-card:nth-child(2)) { margin-top: 9rem; }
  .more { display: flex; justify-content: flex-end; margin-top: 4rem; }
  @media (max-width: 720px) { .projects-grid { grid-template-columns: 1fr; } .projects-grid :global(.project-card:nth-child(2)) { margin-top: 1rem; } }
</style>
