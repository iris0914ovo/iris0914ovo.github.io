---
import SectionHeading from '../ui/SectionHeading.astro';
import { capabilities } from '../../data';
---

<section class="section section-rule">
  <div class="shell">
    <SectionHeading eyebrow="技能" title="我做过的工作" description="以独立站日常运营为主，也有建站、广告素材和自动化流程的实践。" />
    <div class="capability-list">
      {capabilities.map((item) => (
        <article>
          <span class="index">{item.index}</span>
          <h3>{item.title}</h3>
          <p>{item.text}</p>
          <div class="tags">{item.tags.map((tag) => <span class="tag">{tag}</span>)}</div>
        </article>
      ))}
    </div>
  </div>
</section>

<style>
  .capability-list { border-top: 1px solid var(--line); }
  article { display: grid; grid-template-columns: .25fr .7fr 1.1fr .7fr; gap: 1.5rem; align-items: start; padding: 1.35rem 0; border-bottom: 1px solid var(--line); }
  .index { color: var(--sage); font-size: 1rem; }
  h3 { margin: 0; font-size: 1.15rem; font-weight: 600; }
  p { margin: 0; color: var(--muted); font-size: .9rem; }
  .tags { display: flex; flex-wrap: wrap; justify-content: flex-end; gap: .4rem; }
  @media (max-width: 820px) { article { grid-template-columns: 2.5rem 1fr; } article p, .tags { grid-column: 2; } .tags { justify-content: flex-start; } }
</style>
