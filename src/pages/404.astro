---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" noindex>
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1 class="page-title">这里暂时<br /><em>什么也没有。</em></h1>
    <a class="button" href="/">返回首页 →</a>
  </section>
</BaseLayout>
<style>.not-found { min-height: 70svh; padding-top: 8rem; }.not-found em { color: var(--sage); font-weight: 400; }.button { margin-top: 3rem; }</style>
