---
import BaseLayout from '../layouts/BaseLayout.astro';
---
<BaseLayout title="页面未找到" noindex>
  <section class="not-found shell">
    <p class="eyebrow">404</p>
    <h1 class="page-title">找不到这个页面</h1>
    <a class="button" href="/">返回首页 →</a>
  </section>
</BaseLayout>
<style>.not-found { min-height: 60svh; padding-top: 5rem; }.button { margin-top: 2rem; }</style>
