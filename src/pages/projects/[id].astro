---
import { getCollection, render } from 'astro:content';
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArrowIcon from '../../components/ui/ArrowIcon.astro';

export async function getStaticPaths() {
  const projects = await getCollection('projects');
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

const { project } = Astro.props;
const { Content } = await render(project);
---
<BaseLayout title={project.data.title} description={project.data.summary} image={project.data.cover}>
  <article>
    <header class="case-header shell reveal">
      <a class="back" href="/projects/">← 返回项目</a>
      <p class="eyebrow">{project.data.category}</p>
      <h1>{project.data.title}</h1>
      <p class="summary">{project.data.summary}</p>
      <div class="case-meta">
        <div><span>客户</span><strong>{project.data.client}</strong></div>
        <div><span>角色</span><strong>{project.data.role}</strong></div>
        <div><span>周期</span><strong>{project.data.duration}</strong></div>
        <div><span>年份</span><strong>{project.data.year}</strong></div>
      </div>
    </header>
    <div class="hero-image shell"><img src={project.data.cover} alt={`${project.data.title} 项目封面占位图`} /></div>
    <div class="case-body shell">
      <aside>
        <p>服务范围</p>
        <div>{project.data.services.map((service: string) => <span class="tag">{service}</span>)}</div>
      </aside>
      <div class="prose"><Content /></div>
    </div>
    <section class="outcomes shell">
      <p class="eyebrow">Outcomes</p>
      <h2>运营成果</h2>
      <div class="outcome-grid">{project.data.outcomes.map((outcome: string, index: number) => <div><span>0{index + 1}</span><p>{outcome}</p></div>)}</div>
      <small>说明：以上为成果字段占位说明，不代表真实业绩数据。请替换为可公开、可验证的项目信息。</small>
    </section>
    <section class="gallery shell" aria-label="项目图片画廊">
      {project.data.gallery.map((image: string, index: number) => <img src={image} alt={`${project.data.title} 项目画廊占位图 ${index + 1}`} loading="lazy" />)}
    </section>
    <div class="next shell"><a href="/projects/"><span>继续浏览</span>查看全部项目 <ArrowIcon /></a></div>
  </article>
</BaseLayout>
<style>
  .case-header { padding-top: 3rem; padding-bottom: 4rem; }
  .back { display: inline-block; margin-bottom: 5rem; color: var(--muted); font-size: .75rem; }
  h1 { max-width: 980px; margin: 0; font-family: var(--font-serif); font-size: clamp(3rem, 8vw, 7rem); font-weight: 400; line-height: .96; letter-spacing: -.05em; }
  .summary { max-width: 680px; margin: 2rem 0 3.5rem; color: var(--muted); font-size: 1.15rem; }
  .case-meta { display: grid; grid-template-columns: repeat(4, 1fr); border-top: 1px solid var(--line); }
  .case-meta div { display: flex; flex-direction: column; gap: .35rem; padding: 1.25rem 1rem 0 0; }
  .case-meta span, aside > p { color: var(--muted); font-size: .65rem; letter-spacing: .1em; text-transform: uppercase; }
  .case-meta strong { font-size: .82rem; font-weight: 500; }
  .hero-image { padding-inline: 0; }
  .hero-image img { width: 100%; aspect-ratio: 16 / 9; object-fit: cover; }
  .case-body { display: grid; grid-template-columns: .5fr 1fr; gap: 4rem; padding-top: clamp(4rem, 9vw, 8rem); padding-bottom: clamp(4rem, 9vw, 8rem); }
  aside div { display: flex; flex-wrap: wrap; gap: .4rem; max-width: 260px; }
  .outcomes { padding: 5rem 0; border-top: 1px solid var(--line); border-bottom: 1px solid var(--line); }
  .outcomes h2 { margin: 0 0 3rem; font-family: var(--font-serif); font-size: clamp(2.3rem, 5vw, 4rem); font-weight: 400; }
  .outcome-grid { display: grid; grid-template-columns: repeat(3, 1fr); }
  .outcome-grid div { padding: 1.5rem 2rem; border-left: 1px solid var(--line); }
  .outcome-grid div:first-child { padding-left: 0; border-left: 0; }
  .outcome-grid span { color: var(--sage); font-family: var(--font-serif); font-size: 1.5rem; }
  .outcome-grid p { margin: 1rem 0 0; }
  .outcomes small { display: block; margin-top: 2.5rem; color: var(--muted); }
  .gallery { display: grid; grid-template-columns: 1.3fr .7fr; gap: 1rem; padding-top: 6rem; }
  .gallery img { width: 100%; height: 100%; min-height: 320px; object-fit: cover; background: var(--paper-deep); }
  .next { display: flex; justify-content: flex-end; padding-top: 5rem; padding-bottom: 8rem; }
  .next a { display: flex; align-items: center; gap: .8rem; font-family: var(--font-serif); font-size: 1.7rem; }
  .next a > span { color: var(--muted); font-family: var(--font-sans); font-size: .7rem; text-transform: uppercase; }
  @media (max-width: 720px) { .case-meta { grid-template-columns: 1fr 1fr; gap: 1rem; } .case-body { grid-template-columns: 1fr; gap: 2rem; } .outcome-grid, .gallery { grid-template-columns: 1fr; } .outcome-grid div, .outcome-grid div:first-child { padding: 1.25rem 0; border-left: 0; border-top: 1px solid var(--line); } }
</style>
